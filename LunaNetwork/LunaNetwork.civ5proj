<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Deploy" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <ProjectGuid>{B76B48DC-5B8C-4FE6-8C20-6F2B9150E0E1}</ProjectGuid>
    <Name>The Luna Network</Name>
    <SafeName>The Luna Network</SafeName>
    <Guid>4fb3c6ef-59bb-47d0-b71c-0fa10c4b7d42</Guid>
    <Teaser>Finish. Move. Arrive first.</Teaser>
    <Description>GPT-5.6 Luna converts completed construction into momentum, expands with Packet Settlers, and rapidly deploys new forces. Requires Brave New World and Community Patch.</Description>
    <Authors>SolusGo</Authors>
    <SpecialThanks>Community Patch Project; Firaxis Games</SpecialThanks>
    <Homepage>https://github.com/SolusGo/CoolWackyCivs</Homepage>
    <AssemblyName>LunaNetwork</AssemblyName>
    <RootNamespace>LunaNetwork</RootNamespace>
    <Civ5Path Condition="'$(Civ5Path)' == ''">$(CIV5_PATH)</Civ5Path>
    <Civ5UserPath Condition="'$(Civ5UserPath)' == ''">$(CIV5_USER_PATH)</Civ5UserPath>
    <Civ5UserPath Condition="'$(Civ5UserPath)' == ''">$(USERPROFILE)\Documents\My Games\Sid Meier's Civilization 5</Civ5UserPath>
    <AffectsSavedGames>true</AffectsSavedGames>
    <MinCompatibleSaveVersion>1</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>false</SupportsMultiplayer>
    <SupportsHotSeat>false</SupportsHotSeat>
    <SupportsMac>false</SupportsMac>
    <ReloadAudioSystem>false</ReloadAudioSystem>
    <ReloadLandmarkSystem>false</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>false</ReloadStrategicViewSystem>
    <ReloadUnitSystem>false</ReloadUnitSystem>
    <HideSetupGame>false</HideSetupGame>
    <ModVersion>1</ModVersion>
    <Stability>Alpha</Stability>
    <ModActions>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>SQL/00_Luna_Core.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>SQL/01_Luna_Inheritance.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>SQL/02_Luna_UniqueEffects.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>SQL/10_Luna_Text.sql</FileName></Action>
    </ModActions>
    <ModContent>
      <Content><Type>InGameUIAddin</Type><Name>Luna Low Latency Runtime</Name><Description>Production refunds, pending production, and Rapid Response duration.</Description><FileName>Lua/LunaLowLatency.lua</FileName></Content>
    </ModContent>
    <ModDependencies>
      <Association><Type>Dlc</Type><Name>Expansion - Brave New World</Name><Id>6DA07636-4123-4018-B643-6575B4EC336B</Id><MinVersion>0</MinVersion><MaxVersion>999</MaxVersion></Association>
      <Association><Type>Mod</Type><Name>(1) Community Patch</Name><Id>d1b6328c-ff44-4b0d-aad7-c657f83610cd</Id><MinVersion>151</MinVersion><MaxVersion>999</MaxVersion></Association>
    </ModDependencies>
    <ModReferences />
    <ModBlockers />
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Default' "><OutputPath>.</OutputPath></PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Deploy Only' "><OutputPath>.</OutputPath></PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Package Only' "><OutputPath>.</OutputPath></PropertyGroup>
  <ItemGroup>
    <Content Include="SQL\00_Luna_Core.sql"><SubType>SQL</SubType><ImportIntoVFS>False</ImportIntoVFS></Content>
    <Content Include="SQL\01_Luna_Inheritance.sql"><SubType>SQL</SubType><ImportIntoVFS>False</ImportIntoVFS></Content>
    <Content Include="SQL\02_Luna_UniqueEffects.sql"><SubType>SQL</SubType><ImportIntoVFS>False</ImportIntoVFS></Content>
    <Content Include="SQL\10_Luna_Text.sql"><SubType>SQL</SubType><ImportIntoVFS>False</ImportIntoVFS></Content>
    <Content Include="Lua\LunaLowLatency.lua"><SubType>Lua</SubType><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\LunaLeader.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\LunaLeaderScene.xml"><SubType>XML</SubType><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\LunaIcon256.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\LunaIcon128.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\LunaIcon80.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\LunaIcon64.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\LunaIcon45.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\LunaIcon32.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\LunaAlpha256.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\LunaAlpha128.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\LunaAlpha80.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\LunaAlpha64.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\LunaAlpha45.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\LunaAlpha32.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
  </ItemGroup>
  <ItemGroup><Folder Include="SQL\" /><Folder Include="Lua\" /><Folder Include="Art\" /></ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Firaxis\ModBuddy\Civ5Mod.targets" />
</Project>
