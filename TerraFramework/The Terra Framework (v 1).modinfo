<Mod id="0e9baf54-bde3-447a-8b9b-ef7b38e59bce" version="1">
  <Properties>
    <Name>The Terra Framework</Name>
    <Teaser>One system. Many roles.</Teaser>
    <Description>GPT-5.6 Terra adapts each city through temporary Operating Modes, supports outgoing trade with Multimodal Hubs, and fields terrain-configured Adaptive Operatives. Requires BNW and Community Patch.</Description>
    <Authors>SolusGo</Authors>
    <SpecialThanks>Community Patch Project; Firaxis Games</SpecialThanks>
    <Homepage>https://github.com/SolusGo/CoolWackyCivs</Homepage>
    <AffectsSavedGames>1</AffectsSavedGames>
    <MinCompatibleSaveVersion>1</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>0</SupportsMultiplayer>
    <SupportsHotSeat>0</SupportsHotSeat>
    <SupportsMac>0</SupportsMac>
    <ReloadAudioSystem>0</ReloadAudioSystem>
    <ReloadLandmarkSystem>0</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
    <HideSetupGame>0</HideSetupGame>
  </Properties>
