<Mod id="4c02158d-ad52-4b73-bf2a-555ce58a1e60" version="7">
  <Properties>
    <Name>Cool Wacky Civs</Name>
    <Teaser>Six strange leaders. Six stranger ways to rule.</Teaser>
    <Description>One collection containing The Rou'ls Ascendancy, The Luna Network, The Terra Framework, The Capano Circuit, The Filthy Realm, and The Dual Order. Requires Brave New World and Community Patch.</Description>
    <Authors>SolusGo</Authors>
    <SpecialThanks>Community Patch Project; Firaxis Games; Enrico Capano</SpecialThanks>
    <Homepage>https://github.com/SolusGo/CoolWackyCivs</Homepage>
    <AffectsSavedGames>1</AffectsSavedGames>
