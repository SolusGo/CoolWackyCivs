    <ModContent>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Rou'ls Anima and Abilities</Name>
        <Description>Top-panel Anima counter, Transmigration, and Great Migration controls.</Description>
        <FileName>RoulsAscendancy/UI/RoulsPanel.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Luna Low Latency Runtime</Name>
        <Description>Production refunds and Rapid Response lifecycle.</Description>
        <FileName>LunaNetwork/Lua/LunaLowLatency.lua</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Terra Adaptive Intelligence</Name>
        <Description>Operating Modes, terrain configurations, and trade-route support.</Description>
        <FileName>TerraFramework/Lua/TerraRuntime.lua</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Capano Circuit Runtime</Name>
        <Description>Projects, SEND rewards, Boulder Sectors, training, movement, techniques, and diplomacy.</Description>
        <FileName>CapanoCircuit/Lua/CapanoRuntime.lua</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Filthy Realm</Name>
        <Description>Filthy Point counter, active ability panel, Filth runtime, and Peace Lord intervention.</Description>
        <FileName>FilthyRealm/UI/FilthyPanel.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Dual Order</Name>
        <Description>Balance Pressure indicator, Twin Mandates, Zeal, and Divided Templar runtime.</Description>
        <FileName>DualOrder/UI/DualOrderPanel.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The RomanGladius Network</Name>
        <Description>Network Dashboard, Server staff, Reputation, chat, events, milestones, and population yields.</Description>
        <FileName>RomanGladiusNetwork/UI/RomanGladiusPanel.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Eternal Number Ten Runtime</Name>
        <Description>Legacy, Career Chapters, formation warfare, Assists, Resilience, La Masia, and Epilogue gameplay.</Description>
        <FileName>EternalNumberTen/Lua/MessiRuntime.lua</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Eternal Number Ten Legacy Panel</Name>
        <Description>Optional Legacy, Career Chapter, Third Star, and Epilogue interface.</Description>
        <FileName>EternalNumberTen/UI/MessiLegacyPanel.xml</FileName>
      </Content>
    </ModContent>
