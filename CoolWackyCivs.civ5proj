    <ModContent>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Rou'ls Anima and Abilities</Name>
        <Description>Top-panel Anima counter, Transmigration, and Great Migration controls.</Description>
        <FileName>RoulsAscendancy/UI/RoulsPanel.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Luna Low Latency Runtime</Name>
        <Description>Production refunds and Rapid Response lifecycle.</Description>
        <FileName>LunaNetwork/Lua/LunaLowLatency.lua</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Terra Adaptive Intelligence</Name>
        <Description>Operating Modes, terrain configurations, and trade-route support.</Description>
        <FileName>TerraFramework/Lua/TerraRuntime.lua</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Capano Circuit Runtime</Name>
        <Description>Projects, SEND rewards, Boulder Sectors, training, movement, techniques, and diplomacy.</Description>
        <FileName>CapanoCircuit/Lua/CapanoRuntime.lua</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Filthy Realm</Name>
        <Description>Filthy Point counter, active ability panel, Filth runtime, and Peace Lord intervention.</Description>
        <FileName>FilthyRealm/UI/FilthyPanel.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Dual Order</Name>
        <Description>Balance Pressure indicator, Twin Mandates, Zeal, and Divided Templar runtime.</Description>
        <FileName>DualOrder/UI/DualOrderPanel.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The RomanGladius Network</Name>
        <Description>Network Dashboard, Server staff, Reputation, chat, events, milestones, and population yields.</Description>
        <FileName>RomanGladiusNetwork/UI/RomanGladiusPanel.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Eternal Number Ten Runtime</Name>
        <Description>Legacy, Career Chapters, formation warfare, Assists, Resilience, La Masia, and Epilogue gameplay.</Description>
        <FileName>EternalNumberTen/Lua/MessiRuntime.lua</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Eternal Number Ten Legacy Panel</Name>
        <Description>Optional Legacy, Career Chapter, Third Star, and Epilogue interface.</Description>
        <FileName>EternalNumberTen/UI/MessiLegacyPanel.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Boy Beyond the Sky Runtime</Name>
        <Description>Joy of Flight, exploration, combat participation, promotions, training, and Junior FC Prodigy gameplay.</Description>
        <FileName>MasayaBeyondSky/Lua/MasayaRuntime.lua</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Boy Beyond the Sky Joy Panel</Name>
        <Description>Event-driven Joy of Flight meter and threshold-state display.</Description>
        <FileName>MasayaBeyondSky/UI/MasayaJoyPanel.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The First Night Memories</Name>
        <Description>Memories, Home, Survivor exploration and era narratives.</Description>
        <FileName>PaulsoaresJr/Lua/PSJRuntime.lua</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Viltrum Empire</Name>
        <Description>Imperial status, Great Purge, Scourge and survivor gameplay.</Description>
        <FileName>ViltrumEmpire/UI/ViltrumPanel.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Tokenized Intelligence</Name>
        <Description>Persistent Token economy, AI spending and event-driven Prompt Console.</Description>
        <FileName>TokenizedIntelligence/UI/TokenPanel.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Kingdoms Overview</Name>
        <Description>Persistent politics, AI and realm UI.</Description>
        <FileName>TheKingdoms/UI/KingdomsOverview.xml</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>The Sol Intellect</Name>
        <Description>Deep Deliberation, Insight and specialist development.</Description>
        <FileName>SolIntellect/Lua/SolRuntime.lua</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Imperial Administration</Name>
        <Description>Persistent imperial gameplay, AI and administration UI.</Description>
        <FileName>TheShatteredEmpire/UI/ImperialAdministration.xml</FileName>
      </Content>
      <Content><Type>InGameUIAddin</Type><Name>Sanctuary Council</Name><Description>Last City survival and management interface</Description><FileName>TheLastCity/UI/SanctuaryCouncil.xml</FileName></Content>
      <Content><Type>InGameUIAddin</Type><Name>Relentless Seven Gameplay</Name><Description>Relentless Seven Gameplay</Description><FileName>CristianoRonaldo/Lua/CR7Runtime.lua</FileName></Content>
      <Content><Type>InGameUIAddin</Type><Name>CR7 Ambition and Career</Name><Description>CR7 Ambition and Career</Description><FileName>CristianoRonaldo/UI/CR7Career.xml</FileName></Content>
    </ModContent>
