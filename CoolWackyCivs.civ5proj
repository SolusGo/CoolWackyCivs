<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Deploy" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <ProjectGuid>{29CABB63-0B67-4511-9499-05FC99674AC5}</ProjectGuid>
    <Name>Cool Wacky Civs</Name>
    <SafeName>Cool Wacky Civs</SafeName>
    <Guid>4c02158d-ad52-4b73-bf2a-555ce58a1e60</Guid>
    <Teaser>Four strange leaders. Four stranger ways to rule.</Teaser>
    <Description>One collection containing The Rou'ls Ascendancy, The Luna Network, The Terra Framework, and The Capano Circuit. Requires Brave New World and Community Patch.</Description>
    <Authors>SolusGo</Authors>
    <SpecialThanks>Community Patch Project; Firaxis Games; Enrico Capano</SpecialThanks>
    <Homepage>https://github.com/SolusGo/CoolWackyCivs</Homepage>
    <AssemblyName>CoolWackyCivs</AssemblyName>
    <RootNamespace>CoolWackyCivs</RootNamespace>
    <Civ5Path Condition="'$(Civ5Path)' == ''">$(CIV5_PATH)</Civ5Path>
    <Civ5UserPath Condition="'$(Civ5UserPath)' == ''">$(CIV5_USER_PATH)</Civ5UserPath>
    <Civ5UserPath Condition="'$(Civ5UserPath)' == ''">$(USERPROFILE)\Documents\My Games\Sid Meier's Civilization 5</Civ5UserPath>
    <AffectsSavedGames>true</AffectsSavedGames>
    <MinCompatibleSaveVersion>1</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>false</SupportsMultiplayer>
    <SupportsHotSeat>false</SupportsHotSeat>
    <SupportsMac>false</SupportsMac>
    <ReloadAudioSystem>false</ReloadAudioSystem>
    <ReloadLandmarkSystem>false</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>false</ReloadStrategicViewSystem>
    <ReloadUnitSystem>false</ReloadUnitSystem>
    <HideSetupGame>false</HideSetupGame>
    <ModVersion>1</ModVersion>
    <Stability>Alpha</Stability>
    <ModActions>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>RoulsAscendancy/SQL/00_Rouls_Core.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>RoulsAscendancy/SQL/01_Rouls_Inheritance.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>RoulsAscendancy/SQL/02_Rouls_UniqueEffects.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>RoulsAscendancy/SQL/10_Rouls_Text.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>LunaNetwork/SQL/00_Luna_Core.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>LunaNetwork/SQL/01_Luna_Inheritance.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>LunaNetwork/SQL/02_Luna_UniqueEffects.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>LunaNetwork/SQL/10_Luna_Text.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>TerraFramework/SQL/00_Terra_Core.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>TerraFramework/SQL/01_Terra_Inheritance.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>TerraFramework/SQL/02_Terra_UniqueEffects.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>TerraFramework/SQL/10_Terra_Text.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>CapanoCircuit/SQL/00_Capano_Core.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>CapanoCircuit/SQL/01_Capano_Inheritance.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>CapanoCircuit/SQL/02_Capano_UniqueEffects.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>CapanoCircuit/SQL/10_Capano_Text.sql</FileName></Action>
    </ModActions>
    <ModContent>
      <Content><Type>InGameUIAddin</Type><Name>Rou'ls Anima and Abilities</Name><Description>Top-panel Anima counter, Transmigration, and Great Migration controls.</Description><FileName>RoulsAscendancy/UI/RoulsPanel.xml</FileName></Content>
      <Content><Type>InGameUIAddin</Type><Name>Luna Low Latency Runtime</Name><Description>Production refunds and Rapid Response lifecycle.</Description><FileName>LunaNetwork/Lua/LunaLowLatency.lua</FileName></Content>
      <Content><Type>InGameUIAddin</Type><Name>Terra Adaptive Intelligence</Name><Description>Operating Modes, terrain configurations, and trade-route support.</Description><FileName>TerraFramework/Lua/TerraRuntime.lua</FileName></Content>
      <Content><Type>InGameUIAddin</Type><Name>Capano Circuit Runtime</Name><Description>Projects, SEND rewards, Boulder Sectors, training, movement, techniques, and diplomacy.</Description><FileName>CapanoCircuit/Lua/CapanoRuntime.lua</FileName></Content>
    </ModContent>
    <ModDependencies>
      <Association><Type>Dlc</Type><Name>Expansion - Brave New World</Name><Id>6DA07636-4123-4018-B643-6575B4EC336B</Id><MinVersion>0</MinVersion><MaxVersion>999</MaxVersion></Association>
      <Association><Type>Mod</Type><Name>(1) Community Patch</Name><Id>d1b6328c-ff44-4b0d-aad7-c657f83610cd</Id><MinVersion>151</MinVersion><MaxVersion>999</MaxVersion></Association>
    </ModDependencies>
    <ModReferences />
    <ModBlockers />
  </PropertyGroup>
