<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Deploy" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <ProjectGuid>{82F66C03-2132-40D7-A819-DF30831C2F6E}</ProjectGuid>
    <Name>The Rou'ls Ascendancy</Name>
    <SafeName>The Rouls Ascendancy</SafeName>
    <Guid>c119a406-5ff3-42ef-b5d8-5c867e494093</Guid>
    <Teaser>The flesh is a coat. Wear it well, and pass it on.</Teaser>
    <Description>Trent Rou'ls preserves fallen veterans through Anima, exchanges distant armies, and sails beside Buddy, Everlasting. Requires Brave New World and Community Patch.</Description>
    <Authors>SolusGo</Authors>
    <SpecialThanks>Community Patch Project; Firaxis Games</SpecialThanks>
    <Homepage>https://github.com/SolusGo/CoolWackyCivs</Homepage>
    <AssemblyName>RoulsAscendancy</AssemblyName>
    <RootNamespace>RoulsAscendancy</RootNamespace>
    <!-- Set game paths in ModBuddy Project Properties or CIV5_PATH/CIV5_USER_PATH. -->
    <Civ5Path Condition="'$(Civ5Path)' == ''">$(CIV5_PATH)</Civ5Path>
    <Civ5UserPath Condition="'$(Civ5UserPath)' == ''">$(CIV5_USER_PATH)</Civ5UserPath>
    <Civ5UserPath Condition="'$(Civ5UserPath)' == ''">$(USERPROFILE)\Documents\My Games\Sid Meier's Civilization 5</Civ5UserPath>
    <AffectsSavedGames>true</AffectsSavedGames>
    <MinCompatibleSaveVersion>1</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>false</SupportsMultiplayer>
    <SupportsHotSeat>false</SupportsHotSeat>
    <SupportsMac>false</SupportsMac>
    <ReloadAudioSystem>false</ReloadAudioSystem>
    <ReloadLandmarkSystem>false</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>false</ReloadStrategicViewSystem>
    <ReloadUnitSystem>false</ReloadUnitSystem>
    <HideSetupGame>false</HideSetupGame>
    <ModVersion>1</ModVersion>
    <Stability>Alpha</Stability>
    <ModActions>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>SQL/00_Rouls_Core.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>SQL/01_Rouls_Inheritance.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>SQL/02_Rouls_UniqueEffects.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>SQL/10_Rouls_Text.sql</FileName></Action>
    </ModActions>
    <ModContent>
      <Content><Type>InGameUIAddin</Type><Name>Rou'ls Anima and Abilities</Name><Description>Persistent Anima mechanics, AI and the Rou'ls ability panel.</Description><FileName>UI/RoulsPanel.xml</FileName></Content>
    </ModContent>
    <ModDependencies>
      <Association><Type>Dlc</Type><Name>Expansion - Brave New World</Name><Id>6DA07636-4123-4018-B643-6575B4EC336B</Id><MinVersion>0</MinVersion><MaxVersion>999</MaxVersion></Association>
      <Association><Type>Mod</Type><Name>(1) Community Patch</Name><Id>d1b6328c-ff44-4b0d-aad7-c657f83610cd</Id><MinVersion>151</MinVersion><MaxVersion>999</MaxVersion></Association>
    </ModDependencies>
    <ModReferences />
    <ModBlockers />
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Default' "><OutputPath>.</OutputPath></PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Deploy Only' "><OutputPath>.</OutputPath></PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Package Only' "><OutputPath>.</OutputPath></PropertyGroup>
  <ItemGroup>
    <Content Include="SQL\00_Rouls_Core.sql"><SubType>SQL</SubType><ImportIntoVFS>False</ImportIntoVFS></Content>
    <Content Include="SQL\01_Rouls_Inheritance.sql"><SubType>SQL</SubType><ImportIntoVFS>False</ImportIntoVFS></Content>
    <Content Include="SQL\02_Rouls_UniqueEffects.sql"><SubType>SQL</SubType><ImportIntoVFS>False</ImportIntoVFS></Content>
    <Content Include="SQL\10_Rouls_Text.sql"><SubType>SQL</SubType><ImportIntoVFS>False</ImportIntoVFS></Content>
    <Content Include="Lua\RoulsCore.lua"><SubType>Lua</SubType><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Lua\RoulsActions.lua"><SubType>Lua</SubType><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="UI\RoulsPanel.xml"><SubType>Lua</SubType><ImportIntoVFS>False</ImportIntoVFS></Content>
    <Content Include="UI\RoulsPanel.lua"><SubType>Lua</SubType><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\RoulsLeader.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\RoulsLeaderScene.xml"><SubType>XML</SubType><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\RoulsIcon256.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\RoulsIcon128.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\RoulsIcon80.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\RoulsIcon64.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\RoulsIcon45.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\RoulsIcon32.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\RoulsAlpha256.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\RoulsAlpha128.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\RoulsAlpha80.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\RoulsAlpha64.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\RoulsAlpha45.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
    <Content Include="Art\RoulsAlpha32.dds"><ImportIntoVFS>True</ImportIntoVFS></Content>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="SQL\" /><Folder Include="Lua\" /><Folder Include="UI\" /><Folder Include="Art\" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Firaxis\ModBuddy\Civ5Mod.targets" />
</Project>
