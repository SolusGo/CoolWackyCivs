<?xml version='1.0' encoding='utf-8'?>
<Mod id="4c02158d-ad52-4b73-bf2a-555ce58a1e60" version="17">
  <Properties>
    <Name>Cool Wacky Civs</Name>
    <Teaser>Twelve strange leaders. Twelve stranger ways to rule.</Teaser>
    <Description>One collection containing The Rou'ls Ascendancy, The Luna Network, The Terra Framework, The Capano Circuit, The Filthy Realm, The Dual Order, The RomanGladius Network, The Eternal Number Ten, The Boy Beyond the Sky, The First Night, The Viltrum Empire, and The Tokenized Intelligence. Requires Brave New World and Community Patch.</Description>
    <Authors>SolusGo</Authors>
    <SpecialThanks>Community Patch Project; Firaxis Games; Enrico Capano</SpecialThanks>
    <Homepage>https://github.com/SolusGo/CoolWackyCivs</Homepage>
    <AffectsSavedGames>1</AffectsSavedGames>
    <MinCompatibleSaveVersion>1</MinCompatibleSaveVersion>
