    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="DualOrder/UI/DualOrderPanel.xml">
      <Name>The Dual Order</Name>
      <Description>Balance Pressure indicator, Twin Mandates, Zeal, and Divided Templar runtime.</Description>
    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="RomanGladiusNetwork/UI/RomanGladiusPanel.xml">
      <Name>The RomanGladius Network</Name>
      <Description>Network Dashboard, Server staff, Reputation, chat, events, milestones, and population yields.</Description>
    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="EternalNumberTen/Lua/MessiRuntime.lua">
      <Name>The Eternal Number Ten Runtime</Name>
      <Description>Legacy, Career Chapters, formation warfare, Assists, Resilience, La Masia, and Epilogue gameplay.</Description>
    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="EternalNumberTen/UI/MessiLegacyPanel.xml">
      <Name>The Eternal Number Ten Legacy Panel</Name>
