    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="MasayaBeyondSky/Lua/MasayaRuntime.lua">
      <Name>The Boy Beyond the Sky Runtime</Name>
      <Description>Joy of Flight, exploration, combat participation, promotions, training, and Junior FC Prodigy gameplay.</Description>
    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="MasayaBeyondSky/UI/MasayaJoyPanel.xml">
      <Name>The Boy Beyond the Sky Joy Panel</Name>
